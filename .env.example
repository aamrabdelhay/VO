# Required
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
PLATFORM_ENCRYPTION_KEY=replace-with-a-long-random-production-key

# First-run owner account
PLATFORM_ADMIN_EMAIL=admin@platform.local
PLATFORM_ADMIN_PASSWORD=replace-with-a-strong-password
PLATFORM_OPEN_SIGNUP=0

# Public platform and generated application domains
PLATFORM_PUBLIC_URL=https://platform.example.com
PLATFORM_DOMAIN=apps.example.com
PLATFORM_CNAME_TARGET=edge.apps.example.com

# Runtime and storage for self-hosted mode
PLATFORM_RUNTIME_DRIVER=docker
PLATFORM_HOST_ID=local
PLATFORM_REGION=local
PLATFORM_STORAGE_ROOT=.platform/storage
PLATFORM_WORKSPACE_ROOT=.platform/workspaces
AI_WORKSPACE_ROOT=.platform/ai-workspaces
PLATFORM_RUNTIME_NETWORK=bridge
TRAEFIK_DYNAMIC_DIR=infrastructure/traefik/dynamic
TRAEFIK_CERT_RESOLVER=letsencrypt

# When VO itself runs on Vercel, deployments are delegated to Vercel's deployment API.
# Add a Vercel access token with permission to create/manage projects and deployments in the team.
VERCEL_DEPLOY_PROVIDER=vercel
VERCEL_DEPLOY_TOKEN=
VERCEL_DEPLOY_TEAM_ID=
# Optional aliases supported by the code:
# VERCEL_TOKEN=
# VERCEL_OIDC_TOKEN=

# GitHub App integration
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# Optional fallback for private repositories
GITHUB_TOKEN=

# AI provider fallback; project BYOK configuration is preferred
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-4-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_API_KEY=
AI_BASE_URL=

# Garvex realtime voice
# Keep all provider keys server-side. The browser receives only an expiring Daily meeting token.
DAILY_API_KEY=
PIPECAT_CLOUD_API_KEY=
# Hosted Pipecat Cloud agent name, e.g. your deployed Garvex agent.
GARVEX_PIPECAT_AGENT=
# Alternative persistent runner with a POST /start endpoint.
GARVEX_VOICE_AGENT_URL=
GARVEX_REALTIME_LLM_MODEL=openai/gpt-oss-120b
# The worker currently uses Pipecat's streaming Groq TTS for lowest-latency audio output.
GARVEX_REALTIME_TTS_PROVIDER=groq
GROQ_API_KEY=
# Existing non-realtime/media paths also use OpenRouter.
OPENROUTER_API_KEY=

# Set to 1 for API-only control-plane replicas
PLATFORM_DISABLE_WORKER=0
